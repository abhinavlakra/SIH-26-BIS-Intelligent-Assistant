# ManakMitra — backend configuration
# Copy this file to `.env` and fill in what you need.
# The backend RUNS WITHOUT ANY KEY (extractive fallback mode) — a key only
# upgrades answers from "extractive" to "LLM-generated, grounded, cited".

# --- LLM (generation only; embeddings are always local/offline) ---
LLM_PROVIDER=anthropic

# Auth — pick ONE of the two options below.
#
# Option A: Anthropic directly. Uses the x-api-key header against
#   api.anthropic.com. Leave ANTHROPIC_AUTH_TOKEN / ANTHROPIC_BASE_URL blank.
ANTHROPIC_API_KEY=
#
# Option B: an Anthropic-COMPATIBLE router (e.g. agentrouter.org). Set a Bearer
#   auth token + the router's base URL. When ANTHROPIC_AUTH_TOKEN is set it wins
#   over ANTHROPIC_API_KEY (the SDK sends `Authorization: Bearer`). The base URL
#   must NOT include /v1 — the SDK appends /v1/messages itself.
#     ANTHROPIC_AUTH_TOKEN=sk-...your-agentrouter-key...
#     ANTHROPIC_BASE_URL=https://agentrouter.org
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=

# Model ID (complete as-is; do not append a date suffix).
#   Anthropic direct: claude-haiku-4-5 / claude-sonnet-5 / claude-opus-5
#   agentrouter.org : claude-opus-4-6 (their default) / claude-opus-4-7 /
#                     claude-opus-4-8  — it does NOT serve Haiku, so if you use
#                     agentrouter you MUST set one of these.
ANTHROPIC_MODEL=claude-haiku-4-5
LLM_MAX_TOKENS=2048
# Fail fast to extractive mode if the API is unreachable mid-demo.
LLM_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=0
# After a failure, skip the API entirely for this long (circuit breaker), so
# only the first affected request stalls and the rest degrade instantly.
LLM_CIRCUIT_COOLDOWN_SECONDS=60

# --- Embeddings (local, free, offline) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Retrieval defaults ---
DEFAULT_TOP_K=5
DEFAULT_TOP_N=5

# --- Optional: expand the corpus from the public data.gov.in BIS catalogue ---
# Get a free key at https://data.gov.in (My Account -> API key), then set both.
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCE_ID=
